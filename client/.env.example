# Khoj — client environment (Vite)
#
# Copy to .env.local (gitignored) or .env.
#
# ONLY variables prefixed with VITE_ are exposed to the browser bundle.
# Everything else is silently unavailable client-side. That is not a security
# measure to rely on — it is a hard wall. Never put a secret behind VITE_.

# ─────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────

# Base URL of the Hono API.
# Dev:  the Vite proxy handles this, so a relative path is fine.
# Prod: the Render Web Service URL, e.g. https://khoj-api.onrender.com
VITE_API_BASE=/api


# ─────────────────────────────────────────────────────────────
# Local inference
# ─────────────────────────────────────────────────────────────

# Embedding model, fetched from the Hugging Face CDN at runtime.
# Weights are NOT committed to the repo.
# Must match EMBEDDING_MODEL / EMBEDDING_DIMENSIONS in the server .env —
# a mismatch means vectors the server cannot index.
VITE_EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX

# Set false to force the WASM backend for testing, even where WebGPU
# is available. Useful for reproducing a judge's slower device.
VITE_USE_WEBGPU=true

# Where ONNX Runtime caches weights (browser Cache API).
VITE_MODEL_CACHE_DIR=/models

# Disable to ship without the local model. Retrieval degrades to keyword
# match — see the cut list in PLAN.md.
VITE_LOCAL_EMBEDDING_ENABLED=true


# ─────────────────────────────────────────────────────────────
# Observability — optional
# ─────────────────────────────────────────────────────────────

# DSNs are designed to be public. This one IS meant for the browser.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_SENTRY_ENVIRONMENT=development

# Injects SENTRY_DSN into client/.env.example automatically.
# See vite.config.ts Define block.
VITE_SENTRY_DSN_TEMPLATE=


# ─────────────────────────────────────────────────────────────
# Features
# ─────────────────────────────────────────────────────────────

# Twelve-hour cache of the last advice response, for offline use.
VITE_OFFLINE_CACHE_TTL_MS=43200000

# Show the staleness banner. Do not turn this off — the app is making
# driving decisions, and stale weather presented as current is worse
# than no app.
VITE_SHOW_STALENESS_BANNER=true