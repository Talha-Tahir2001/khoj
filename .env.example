# Khoj - server environment
#
# Copy to .env and fill in. Every key has a graceful fallback (see
# docs/ARCHITECTURE.md "Error handling"), so the app runs with an empty file.
#
# .env is gitignored. Never commit real values.
# On Render, set these in the dashboard or in render.yaml - not in a file.

# ─────────────────────────────────────────────────────────────
# Required for $vectorSearch
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string. M0 free tier is fine.
# Server-only. Must never appear in client/.env.
#
#   1. Atlas dashboard -> Connect -> Drivers -> copy the Node.js string
#   2. Replace <password> with the DB user's password, URL-encoded if it
#      contains @ : / ? # [ ] or %
#   3. Replace <cluster> with the hostname Atlas gave you, e.g.
#      cluster0.abcde.mongodb.net  -- the angle brackets are PLACEHOLDERS.
#
# A literal "<cluster>" left in here does NOT fail loudly at startup. The server
# validates this at boot and refuses to start.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority


# ─────────────────────────────────────────────────────────────
# DNS - local development only. Leave UNSET in production.
# ─────────────────────────────────────────────────────────────
# Atlas mongodb+srv:// URIs need a DNS SRV lookup. Some networks and resolvers
# mishandle SRV badly enough to hang for ~30 s before failing. Setting this
# points Node at a public resolver instead, which fixed it on one machine:
# 31,000 ms/ETIMEOUT -> 142 ms.
#
# Why it is opt-in rather than just called in code:
#   - dns.setServers() is process-global, not Mongo-scoped
#   - it breaks split-horizon DNS on corporate/campus/VPN networks
#   - 8.8.8.8 / 1.1.1.1 are blocked on some networks entirely
# On Render, Atlas SRV resolves through internal DNS and this is unnecessary.
#
# The app degrades gracefully without it either way.
# DNS_SERVERS=8.8.8.8,1.1.1.1


# ─────────────────────────────────────────────────────────────
# Scoring
# ─────────────────────────────────────────────────────────────

# Which Scorer implementation to use: "rules" (default) or "tabpfn".
# See PRD.md section 8 - rules is a pure, unit-tested function. TabPFN has no
# JS runtime, so "tabpfn" calls the Prior Labs REST API, which is a metered
# vendor request and weakens the local-inference story. Off by default.
SCORER=rules

# Only read when SCORER=tabpfn. Leave blank otherwise.
TABPFN_API_KEY=
TABPFN_MODEL_PATH=v3.5_default

# Embedding model used client-side. Drives the Atlas index dimension.
# Verified empirically: EmbeddingGemma-300M emits exactly 768 dimensions.
EMBEDDING_MODEL=onnx-community/embeddinggemma-300m-ONNX
EMBEDDING_DIMENSIONS=768


# ─────────────────────────────────────────────────────────────
# Weather (Open-Meteo - no key required)
# ─────────────────────────────────────────────────────────────

# Overridable only for testing. Non-commercial use needs no key.
OPEN_METHO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METHO_API_KEY=


# ─────────────────────────────────────────────────────────────
# AI - optional, has a rule-based fallback
# ─────────────────────────────────────────────────────────────

# Called as a plain REST request, not through @google/genai. The SDK fixes the
# base URL and retries silently; both mattered here. x-goog-api-key is used
# rather than ?key= so the credential stays out of URLs and access logs.
#
# AI Studio (default):
#   GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Vertex AI - point at your project. This is a different endpoint shape, not
# just a different host:
#   GEMINI_BASE_URL=https://<location>-aiplatform.googleapis.com/v1/projects/<project>/locations/<location>
#
# A gateway or proxy in front of either works too.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

# Vertex AI. Worth setting even if AI Studio works: THE TWO BILL DIFFERENT
# PROJECTS, so one can be out of credit while the other is fine. Verified - a
# key refused on AI Studio with "prepayment credits are depleted" answered
# normally on a Vertex project.
#
# Leave the project blank to use AI Studio only. Set it and the brief layer falls
# through to Vertex when AI Studio refuses.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
#
# Or an explicit second endpoint if it is not a plain Vertex URL:
# GEMINI_FALLBACK_BASE_URL=https://<location>-aiplatform.googleapis.com/v1/projects/<project>/locations/<location>
#
# The model path differs between the two, and getting it wrong returns a clean
# 404 that looks exactly like "model unavailable":
#   AI Studio  <base>/models/<id>
#   Vertex     <base>/publishers/google/models/<id>
#
# Google hosts open-weight Gemma on AI Studio only. A gemma-* id sent to Vertex
# is always a 404, so the app never tries it.

# Briefing model. Tried in order across every configured surface.
#
# An open-weight gemma-* id is the stronger claim for the Gemma challenge
# category - it is the same family as the EmbeddingGemma running client-side,
# not a hosted Gemini model wearing the name. The response reports which model
# actually wrote the brief, so a hosted fallback is never presented as Gemma.
GEMINI_MODEL=gemma-4-31b-it
GEMINI_TIMEOUT_MS=20000

# If false, the rule-based brief is used. Useful for demoing the fallback.
GEMINI_ENABLED=true


# ─────────────────────────────────────────────────────────────
# Voice (ElevenLabs) - optional
# ─────────────────────────────────────────────────────────────
#
# WARNING, and this one is a genuine trap: a FREE ElevenLabs plan cannot use the
# premade LIBRARY voices over the API at all. It reports this as
#   402 paid_plan_required
#   "Free users cannot use library voices via the API"
# which reads exactly like exhausted credits and is not.
#
# The app probes known free-tier-usable voices and falls back automatically, so
# you do not have to diagnose this yourself - but if the Play button is missing,
# this is why.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=bIHbv24MWmeRgasZH58o
ELEVENLABS_MODEL_ID=eleven_flash_v2_5


# ─────────────────────────────────────────────────────────────
# Live reports (SerpApi) - optional, 250-search free tier
# ─────────────────────────────────────────────────────────────

# Budgeted per docs/DATA.md: ~180 trail queries, ~50 verification, ~20 reserve.
# Cached 12h server-side. Never call this per-request.
SERPAPI_KEY=
SERPAPI_GL=pk


# ─────────────────────────────────────────────────────────────
# Observability - optional
# ─────────────────────────────────────────────────────────────

# DSNs are designed to be public. Safe in the browser bundle.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Prompt/response capture is PII. Suppress if needed.
SENTRY_SEND_DEFAULT_PII=true
SENTRY_ENVIRONMENT=development


# ─────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Render sets PORT automatically. Only needed locally.
PORT=3000

# Origin of the deployed Static Site. Required for CORS in production -
# the two services are on different *.onrender.com domains.
PUBLIC_SITE_ORIGIN=http://localhost:5173

# Cache TTLs, seconds.
CACHE_TTL_FORECAST=3600
CACHE_TTL_SERP=43200
CACHE_TTL_BRIEF=86400